{
  // Solution-style root config: `tsc -b` type-checks every referenced project.
  // `paths` is repeated here so the shadcn CLI and IDEs resolve the `@/` alias, and
  // `types` because Vercel's builder type-checks api/ functions against this file.
  "files": [],
  "references": [
    {"path": "./tsconfig.app.json"},
    {"path": "./tsconfig.api.json"},
    {"path": "./tsconfig.node.json"}
  ],
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
