# Normalize line endings: LF in the repository and in working trees on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated lockfile: collapsed in GitHub diffs. On merge conflicts, regenerate with `bun install`.
bun.lock linguist-generated
