# =============================================================================
# FrakHub environment variables
# =============================================================================
# Copy this file to `.env` for local development (`.env` is git-ignored) and set
# the same keys in Vercel -> Project -> Settings -> Environment Variables.
#
# Two kinds of variables:
#   VITE_*   Inlined into the browser bundle at build time. PUBLIC by design:
#            anyone can read them in the shipped JavaScript. Never put a secret
#            into a VITE_ variable.
#   others   Server-only. Read by the Vercel functions in `api/` (and by the
#            local API middleware during `bun run dev`). Never exposed to clients.
#
# Changing a VITE_ variable on Vercel requires a redeploy (values are baked into
# the build). Server-only variables apply to new function invocations.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase - browser client (src/lib/supabaseClient.ts)
# -----------------------------------------------------------------------------
# Project URL. Supabase Dashboard -> Project Settings -> Data API.
# Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Supabase Dashboard -> Project Settings -> API Keys.
# Accepts the new publishable key (sb_publishable_...) or the legacy "anon" JWT
# (eyJ...). Safe to expose: every query is still subject to Row Level Security.
# VITE_SUPABASE_PUBLISHABLE_KEY is the preferred name; VITE_SUPABASE_ANON_KEY is
# read as a fallback so existing deployments keep working.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# VITE_SUPABASE_ANON_KEY=eyJ...legacy-anon-jwt


# -----------------------------------------------------------------------------
# Supabase - server only (api/_lib/env.ts)
# -----------------------------------------------------------------------------
# Same project URL as above. Falls back to VITE_SUPABASE_URL when unset.
SUPABASE_URL=https://your-project-ref.supabase.co

# Privileged key that BYPASSES Row Level Security. Server-side only, never prefix
# it with VITE_. Accepts the new secret key (sb_secret_...) or the legacy
# "service_role" JWT. Read in this order: SUPABASE_SECRET_KEY,
# SUPABASE_SERVICE_KEY, SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_your-key


# -----------------------------------------------------------------------------
# Cloudinary - browser uploads (src/lib/cloudinary.ts)
# -----------------------------------------------------------------------------
# Cloud name. Cloudinary Console -> Dashboard -> Product Environment.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# UNSIGNED upload presets (Console -> Settings -> Upload -> Upload presets).
# Recommended preset settings to stay inside the free plan:
#   - Signing mode: Unsigned, "Use filename": off, "Unique filename": on
#   - Incoming transformation: c_limit,w_2560,h_2560 (caps stored size)
#   - Allowed formats: jpg,png,webp (+ pdf for evidence)
# Evidence attachments in MCB cases.
VITE_CLOUDINARY_UPLOAD_PRESET=frakhub_evidence
# Profile pictures (keep a small incoming transformation, e.g. c_fill,g_face,w_512,h_512).
VITE_CLOUDINARY_AVATAR_UPLOAD_PRESET=frakhub_avatars
# Images embedded in Academy course material.
VITE_CLOUDINARY_ACADEMY_UPLOAD_PRESET=frakhub_academy


# -----------------------------------------------------------------------------
# Cloudinary - server only (api/_lib/cloudinary.ts, used to DELETE assets)
# -----------------------------------------------------------------------------
# Console -> Settings -> API Keys. The secret signs destroy requests; keep it
# server-side only.
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
# Optional. Defaults to VITE_CLOUDINARY_CLOUD_NAME.
# CLOUDINARY_CLOUD_NAME=your-cloud-name


# -----------------------------------------------------------------------------
# Vercel Cron (api/cron/daily-cleanup.ts, scheduled in vercel.json)
# -----------------------------------------------------------------------------
# Random string, at least 16 characters. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when it invokes the cron job.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
# The endpoint refuses every request while this is unset.
CRON_SECRET=replace-with-a-long-random-string


# -----------------------------------------------------------------------------
# Optional tooling (not read by the app)
# -----------------------------------------------------------------------------
# Personal access token for the Supabase CLI (`bun run db:types`) in
# non-interactive shells. Interactive use: `bunx supabase login` instead.
# Supabase Dashboard -> Account -> Access Tokens.
# SUPABASE_ACCESS_TOKEN=sbp_...
